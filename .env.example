# Clerk — auth. Get keys from the Clerk dashboard (a Next.js app).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key

# Where Clerk sends people. These match the routes in app/auth.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Control-plane API. The console attaches the Clerk session JWT as a
# Bearer token on every call; the tenant is read from the token.
NEXT_PUBLIC_API_URL=http://localhost:8080

# If your Clerk instance needs a JWT template for the backend audience,
# set its name here and lib/api/client.ts passes it to getToken().
# NEXT_PUBLIC_CLERK_JWT_TEMPLATE=vantageedge
